# Optional. Set these in your shell before `npm run dev` or `npm start`;
# a .env file is not loaded automatically. Everything here can also be set in Connections.
#
# Python interpreter of the environment where tribev2 is installed, if auto-detection misses it.
#   Windows example: C:\Users\you\tribev2\.venv\Scripts\python.exe
ADLENS_TRIBE_PYTHON=
# API keys, if you prefer environment variables to saving keys in the app.
ADLENS_OPENAI_KEY=
ADLENS_ANTHROPIC_KEY=
# Separate profile folder (settings, reports, chats), mostly for testing.
ADLENS_USER_DATA=
